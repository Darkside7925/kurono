# HelloKurono main program
# Demonstrates KCL scripting for Kurono app development.

set app_name "HelloKurono"

print "┌──────────────────────────────────────────┐"
print "│       Welcome to HelloKurono!            │"
print "│   Built with KCL for Kurono OS           │"
print "└──────────────────────────────────────────┘"
print ""

# Show system info
print "System Info:"
print "  OS: " + OS
print "  KCL Version: " + VERSION
print ""

# Simple calculation demo
print "Calculation Demo:"
set sum 0
for i in 1 10 do
  set sum sum + i
end
print "  Sum of 1..10 = "
print sum
print ""

# File I/O demo  
print "Creating test file..."
exec "echo Hello from Kurono app!" "/home/user/app_test.txt"
print "Done!"

print ""
print "App finished. Press any key to exit."
