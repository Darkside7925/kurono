# family: i915 (D4, display only). overlay on kld.config for this family's own
# snapshot (build/kgen-i915); no other family sees these symbols. i915 forces
# ACPI_VIDEO/THERMAL/BACKLIGHT on through select. (satoru)
CONFIG_DRM_I915=y
CONFIG_DRM_I915_CAPTURE_ERROR=n
CONFIG_DRM_I915_COMPRESS_ERROR=n
CONFIG_DRM_I915_DEBUG=n
CONFIG_DRM_I915_DEBUG_GEM=n
CONFIG_DRM_I915_DP_TUNNEL=n
CONFIG_DRM_I915_GVT=n
CONFIG_DRM_I915_PXP=n
CONFIG_DRM_I915_SELFTEST=n
CONFIG_DRM_I915_WERROR=n
# selected by i915 (select, not optional in its Kconfig). (satoru)
CONFIG_ACPI_VIDEO=y
CONFIG_THERMAL=y
# end (satoru)
