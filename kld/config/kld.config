# KLD pinned config fragment, applied on top of x86_64_defconfig by
# tools/fetch_linux.sh (merge_config.sh + olddefconfig + modules_prepare).
# Changing this file is a CENSUS EVENT: struct layouts can move (CONFIG_PINCTRL
# adds struct device.pins, CONFIG_GPIOLIB changes gpio_desc users), so every
# container is rebuilt against the regenerated headers. (satoru)
#
# family: wired nic (e1000e, igc)
CONFIG_E1000E=m
CONFIG_IGC=m
# family: i2c-hid touchpad (laptop: ELAN06FA on LPSS i2c, GPIO on INTC1084)
CONFIG_I2C_HID=m
CONFIG_I2C_HID_ACPI=m
CONFIG_I2C_HID_CORE=m
CONFIG_HID_MULTITOUCH=m
CONFIG_I2C_DESIGNWARE_CORE=m
CONFIG_I2C_DESIGNWARE_PLATFORM=m
CONFIG_MFD_INTEL_LPSS_PCI=m
CONFIG_PINCTRL=y
CONFIG_PINCTRL_INTEL=m
CONFIG_PINCTRL_METEORPOINT=m
CONFIG_PINCTRL_METEORLAKE=m
CONFIG_GPIOLIB=y
CONFIG_GPIO_ACPI=y
# family: wifi (BE200 class 8086:272b, iwlwifi core+pcie with the mvm opmode on
# top of mac80211 and cfg80211; debugfs and tracing stay out). (satoru)
CONFIG_CFG80211=m
CONFIG_CFG80211_DEBUGFS=n
CONFIG_CFG80211_CRDA_SUPPORT=n
CONFIG_MAC80211=m
CONFIG_MAC80211_MESH=n
CONFIG_MAC80211_DEBUGFS=n
CONFIG_IWLMEI=n
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
# 6.12.99 IWLWIFI_LEDS has no prompt and defaults to y, so kconfig forces it
# (and MAC80211_LEDS and LEDS_CLASS through its selects) back on whatever the
# fragment says. the line stays as intent: mvm/led.o plus mac80211/led.o are
# the only LED objects it adds to the census. (satoru)
CONFIG_IWLWIFI_LEDS=n
CONFIG_IWLWIFI_DEBUG=n
CONFIG_IWLWIFI_DEBUGFS=n
CONFIG_IWLWIFI_DEVICE_TRACING=n
# M1 config trim: shrink the stub backlog before adding shim code. EXPERT is
# what makes the promptless symbols (CRDA, RFKILL_INPUT, ...) visible to
# merge_config. (satoru)
CONFIG_EXPERT=y
# tracing is not needed by e1000e, i2chid or iwlwifi before a key/wowlan path.
CONFIG_FTRACE=n
CONFIG_TRACING=n
CONFIG_TRACEPOINTS=n
# LEDs go away with IWLWIFI_LEDS and MAC80211_LEDS (both depend on
# LEDS_CLASS); iwlwifi/mvm/led.c and mac80211/led.c leave the census.
CONFIG_NEW_LEDS=n
CONFIG_LEDS_CLASS=n
CONFIG_INPUT_LEDS=n
CONFIG_EEEPC_LAPTOP=n
CONFIG_THERMAL=n
CONFIG_ACPI_VIDEO=n
# i915 and the cpufreq drivers are the defconfig symbols that select
# ACPI_VIDEO/ACPI_PROCESSOR, and those select THERMAL. none is used by the
# three KLD families (Kurono has its own GPU driver). (satoru)
CONFIG_DRM_I915=n
CONFIG_SCHED_MC_PRIO=n
CONFIG_X86_INTEL_PSTATE=n
CONFIG_X86_ACPI_CPUFREQ=n
CONFIG_X86_AMD_PSTATE=n
CONFIG_X86_PCC_CPUFREQ=n
CONFIG_ACPI_PROCESSOR=n
CONFIG_ACPI_THERMAL=n
CONFIG_RFKILL=n
# REQUIRE_SIGNED_REGDB only has a prompt when CERTIFICATION_ONUS is on; this is
# the fragment-only way to turn the signature requirement off. (satoru)
CONFIG_CFG80211_CERTIFICATION_ONUS=y
CONFIG_CFG80211_REQUIRE_SIGNED_REGDB=n
CONFIG_CFG80211_CRDA_SUPPORT=n
# no EFI runtime in the container and none of the three families needs it;
# fw/uefi.c is dropped from the iwlwifi source list below to match upstream's
# CONFIG_EFI conditional in its Makefile. (satoru)
CONFIG_EFI=n
# ACPI stays on: i2chid binds through ACPI (_HID/_CRS/_DSM) and cfg80211 reads
# the regulatory domain from ACPI where present.
CONFIG_ACPI=y
# kernel crypto API for mac80211 (CCMP/GCM/CMAC/HMAC/ARC4). the core and the
# generic algorithms are compiled UNMODIFIED from the pinned tree into the
# iwlwifi and apitest containers (CRYPTOLIB in kld/Makefile); the self-tests
# are off (we run our own known-answer tests), no FIPS and no accelerated
# variants. (satoru)
CONFIG_CRYPTO=y
CONFIG_CRYPTO_MANAGER=y
CONFIG_CRYPTO_MANAGER_DISABLE_TESTS=y
CONFIG_CRYPTO_MANAGER_EXTRA_TESTS=n
CONFIG_CRYPTO_FIPS=n
CONFIG_CRYPTO_SIMD=n
CONFIG_CRYPTO_USER=n
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=n
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA1_SSSE3=n
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA256_SSSE3=n
CONFIG_CRYPTO_ARC4=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CCM=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_GHASH=y
CONFIG_CRYPTO_GHASH_CLMUL_NI_INTEL=n
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_HMAC=y
# end (satoru)
# family: drm (d0.2 survey and d1: the upstream drm core, kms/shmem helpers
# and the cirrus driver in one container; no fbdev emulation, no fbcon, no
# rendering side). one container per gpu family like the network families.
# (satoru)
CONFIG_DRM=y
# the drm container is 64-bit; CONFIG_COMPAT only adds drm_ioc32.o, whose
# private __get_user_4/__put_user_4 register ABI the ring-3 shim cannot provide.
# (satoru)
CONFIG_COMPAT=n
CONFIG_IA32_EMULATION=n
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
# drm_client.o and drm_client_modeset.o are unconditional in drm-y; the
# selection/setup symbols only gate the fbdev client, which stays out. (satoru)
CONFIG_DRM_FBDEV_EMULATION=n
CONFIG_DRM_CIRRUS_QEMU=y
# family: bochs (qemu bochs-display, drm_gem_vram_helper on TTM). the whole
# ttm core and the vram/ttm gem helpers are built in for this family. (satoru)
CONFIG_DRM_BOCHS=y
CONFIG_DRM_TTM=y
CONFIG_DRM_VRAM_HELPER=y
CONFIG_DRM_TTM_HELPER=y
# optional drm parts off: panic screen, edid firmware loading, debug range
# manager, kunit tests, werror and dynamic debug. (satoru)
CONFIG_DRM_PANIC=n
CONFIG_DRM_LOAD_EDID_FIRMWARE=n
CONFIG_DRM_DEBUG_MM=n
CONFIG_DRM_KUNIT_TEST=n
CONFIG_DRM_WERROR=n
CONFIG_DRM_USE_DYNAMIC_DEBUG=n
# defconfig extras that are not part of the cirrus path: no virtio-gpu, no
# panel/bridge helpers. turning them off keeps the drm census to the core the
# tiny driver actually selects. (satoru)
CONFIG_DRM_VIRTIO_GPU=n
# drm_bridge and drm_panel_bridge are def_bool y under DRM, so drm_panel and
# the bridge wrapper stay in the object list. (satoru)
# end (satoru)
