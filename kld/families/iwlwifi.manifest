# iwlwifi family properties, read by kld/tools/gen_match_table.sh and baked
# into the generated match table the kernel embeds. (satoru)
name iwlwifi
# the BE200 (8086:272b) has BAR0 = 16 KiB with the MSI-X table at 0x2000 and
# the CSR_MSIX registers at 0x2800 in the SAME 4 KiB page, and the PBA at
# 0x3000. the driver must map that page to reach its own registers, so the
# broker lets a grant for this family map the table page (PBA pages stay
# unmapped). this is why the property belongs to the family's manifest and not
# to a device id in the kernel. (satoru)
needs_msix_table_page 1
# end (satoru)
